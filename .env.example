# Required only for the discovery (LLM) run. Replay never reads this.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
HANDSPAN_MODEL=claude-opus-5
HANDSPAN_EFFORT=high
TARGET_APP_PORT=8099
OPERATOR_PORT=8100

# Demo credentials for the local target app. Never a real credential.
# Referenced from artifacts as {{secret:meridian.username}} / {{secret:meridian.password}}
MERIDIAN_USERNAME=tellersvc
MERIDIAN_PASSWORD=demo-pass-not-real
